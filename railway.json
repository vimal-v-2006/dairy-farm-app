{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd server && npm install && npm run build-client",
    "interface": "node"
  },
  "deploy": {
    "startCommand": "cd server && npm start",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  },
  "volumes": [
    {
      "mountPath": "/data",
      "directory": "."
    }
  ]
}